# Copy to .env.local and fill in from Supabase → Project Settings → API

# Public URL of the site (used for canonical URLs, sitemap and OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" (legacy) or "publishable" key — safe to expose, RLS protects data
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Only needed for `npm run db:setup` (server-side, never exposed to the browser)
# DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres
